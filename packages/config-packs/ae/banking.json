  "documentTypes": [
    {
      "key": "trade_invoice",
      "label": "Commercial Invoice",
      "required": true,
      "acceptedFormats": [
        "pdf",
        "jpg",
        "png"
      ],
      "maxSizeMb": 20,
      "aiExtraction": {
        "enabled": true,
        "fields": [
          "invoiceNumber",
          "seller",
          "buyer",
          "goods",
          "hsCode",
          "value",
          "currency",
          "shipmentOrigin",
          "shipmentDestination",
          "incoterms"
        ]
      },
      "fraudChecks": {
        "exifAnalysis": true,
        "duplicateHash": true,
        "fontConsistency": true
      }
    },
    {
      "key": "bill_of_lading",
      "label": "Bill of Lading",
      "required": false,
      "acceptedFormats": [
        "pdf"
      ],
      "maxSizeMb": 20,
      "aiExtraction": {
        "enabled": true,
        "fields": [
          "blNumber",
          "vesselName",
          "portOfLoading",
          "portOfDischarge",
          "shipper",
          "consignee",
          "cargoDescription",
          "containerNumbers"
        ]
      },
      "fraudChecks": {
        "exifAnalysis": false,
        "duplicateHash": true,
        "fontConsistency": true
      }
    },
    {
      "key": "corporate_id",
      "label": "Trade License / Corporate ID",
      "required": true,
      "acceptedFormats": [
        "pdf",
        "jpg",
        "png"
      ],
      "maxSizeMb": 10,
      "aiExtraction": {
        "enabled": true,
        "fields": [
          "companyName",
          "licenseNumber",
          "issueDate",
          "expiryDate",
          "licenseAuthority",
          "activities"
        ]
      },
      "fraudChecks": {
        "exifAnalysis": true,
        "duplicateHash": true,
        "fontConsistency": true
      }
    }
  ],
  "workflows": [
    {
      "id": "aml-customer-onboarding",
      "name": "AML Customer Onboarding (CDD)",
      "entityType": "case",
      "steps": [
        {
          "id": "intake",
          "name": "Customer Intake",
          "type": "form",
          "assignedRole": "kyc_analyst",
          "slaHours": 24,
          "formFields": [
            {
              "key": "entityName",
              "label": "Entity Name",
              "type": "text",
              "required": true
            },
            {
              "key": "entityType",
              "label": "Entity Type",
              "type": "select",
              "required": true,
              "validation": {
                "options": [
                  {
                    "value": "individual",
                    "label": "Individual"
                  },
                  {
                    "value": "corporate",
                    "label": "Corporate"
                  },
                  {
                    "value": "financial_institution",
                    "label": "Financial Institution"
                  }
                ]
              }
            },
            {
              "key": "jurisdiction",
              "label": "Jurisdiction",
              "type": "country",
              "required": true
            },
            {
              "key": "businessActivity",
              "label": "Primary Business Activity",
              "type": "text",
              "required": true
            },
            {
              "key": "expectedTransactionVolume",
              "label": "Expected Annual Volume (AED)",
              "type": "currency"
            },
            {
              "key": "isPep",
              "label": "Is PEP or Related to PEP?",
              "type": "checkbox"
            }
          ],
          "transitions": [
            {
              "to": "initial_screening",
              "label": "Proceed to Screening"
            }
          ]
        },
        {
          "id": "initial_screening",
          "name": "Sanctions & PEP Screening",
          "type": "api_call",
          "assignedRole": "kyc_analyst",
          "slaHours": 1,
          "apiAction": {
            "adapterId": "uae-central-bank",
            "method": "runScreening",
            "params": {
              "lists": [
                "ofac",
                "eu",
                "un",
                "uk_hmt",
                "uae_local"
              ],
              "pepCheck": true,
              "adverseMedia": true
            }
          },
          "transitions": [
            {
              "to": "document_collection",
              "label": "Clear — Proceed",
              "condition": "screening.riskLevel !== 'critical'"
            },
            {
              "to": "enhanced_due_diligence",
              "label": "Hit — Escalate to EDD",
              "condition": "screening.riskLevel === 'critical'"
            }
          ]
        },
        {
          "id": "document_collection",
          "name": "Document Collection",
          "type": "document",
          "slaHours": 72,
          "requiredDocuments": [
            "corporate_id"
          ],
          "transitions": [
            {
              "to": "analyst_review",
              "label": "Documents Complete"
            }
          ]
        },
        {
          "id": "enhanced_due_diligence",
          "name": "Enhanced Due Diligence",
          "type": "review",
          "assignedRole": "compliance_officer",
          "slaHours": 48,
          "transitions": [
            {
              "to": "mlro_review",
              "label": "EDD Complete — Escalate to MLRO"
            },
            {
              "to": "rejected",
              "label": "Reject Onboarding"
            }
          ]
        },
        {
          "id": "analyst_review",
          "name": "KYC Analyst Review",
          "type": "review",
          "assignedRole": "kyc_analyst",
          "slaHours": 48,
          "transitions": [
            {
              "to": "approved",
              "label": "Approve Onboarding"
            },
            {
              "to": "compliance_review",
              "label": "Refer to Compliance"
            }
          ]
        },
        {
          "id": "compliance_review",
          "name": "Compliance Officer Review",
          "type": "review",
          "assignedRole": "compliance_officer",
          "slaHours": 24,
          "transitions": [
            {
              "to": "approved",
              "label": "Approve"
            },
            {
              "to": "mlro_review",
              "label": "Escalate to MLRO"
            },
            {
              "to": "rejected",
              "label": "Reject"
            }
          ]
        },
        {
          "id": "mlro_review",
          "name": "MLRO Decision",
          "type": "review",
          "assignedRole": "mlro",
          "slaHours": 24,
          "transitions": [
            {
              "to": "approved",
              "label": "Approve with Enhanced Monitoring"
            },
            {
              "to": "sar_filing",
              "label": "File SAR"
            },
            {
              "to": "rejected",
              "label": "Reject"
            }
          ]
        },
        {
          "id": "sar_filing",
          "name": "SAR Filing",
          "type": "api_call",
          "assignedRole": "mlro",
          "slaHours": 24,
          "apiAction": {
            "adapterId": "uae-central-bank",
            "method": "fileSar"
          },
          "transitions": [
            {
              "to": "rejected",
              "label": "SAR Filed"
            }
          ]
        },
        {
          "id": "approved",
          "name": "Customer Approved",
          "type": "notification",
          "transitions": []
        },
        {
          "id": "rejected",
          "name": "Onboarding Rejected",
          "type": "notification",
          "transitions": []
        }
      ]
    }
  ],
  "screening": {
    "enabled": true,
    "lists": [
      "ofac",
      "eu",
      "un",
      "uk_hmt",
      "uae_local"
    ],
    "threshold": 0.85,
    "autoEscalate": true,
    "pepCheck": true,
    "adverseMedia": true
  },
  "compliance": {
    "dataResidency": "AE",
    "retentionYears": 5,
    "encryptionRequired": true,
    "auditRequired": true,
    "regulatoryFrameworks": [
      "CBUAE AML-CFT Guidelines 2019",
      "Federal Decree-Law No. 20 of 2018",
      "FATF Recommendations"
    ],
    "reportingObligations": [
      {
        "trigger": "suspicious_transaction",
        "reportType": "SAR",
        "deadline": "within_14_days",
        "regulatorId": "uae-cbuae"
      },
      {
        "trigger": "cash_transaction_above_threshold",
        "reportType": "CTR",
        "deadline": "within_2_days",
        "regulatorId": "uae-cbuae"
      }
    ]
  },
