      "cooldownHours": 48,
      "escalateAfterHours": 96,
      "escalateToRoles": [
        "compliance_officer"
      ]
    },
    {
      "key": "milestone_due_14d",
      "label": "Governance milestone due within 14 days",
      "entityType": "milestone",
